# ============================================================================
# .env.staging.example — CHÉP THÀNH .env.staging RỒI ĐIỀN.
#   Chạy bằng:  chay_thu.bat        (hoặc  $env:BOT_ENV="staging"; npm start)
#
# File này chỉ khai phần KHÁC với .env. Cái gì không khai thì lấy từ .env.
# env_boot.js nạp .env.staging TRƯỚC .env, mà dotenv không ghi đè
# => giá trị ở đây thắng.
# ============================================================================

# --- CHẶN MỌI TÁC ĐỘNG THẬT -------------------------------------------------
# ORDER_DRY_RUN staging tự bật =1 (xem env_boot.js), khai lại cho rõ ràng.
ORDER_DRY_RUN=1
HOA_API_MODE=gia_lap
SHOP_ID=mysp_thu

# --- CHẠY TUẦN TỰ NHƯ BẢN CŨ ------------------------------------------------
# Lần chạy thử ĐẦU TIÊN để =1 cho giống hệt hành vi trước GĐ1.
# Chạy êm 1 ca rồi mới nâng dần 1 -> 3 -> 6.
SONG_SONG=1
MAX_MOI_NHIP=30

# --- CHỈ CHO BOT ĐỤNG VÀO VÀI HỘI THOẠI ------------------------------------
# Điền conversationId (ngăn bằng dấu phẩy) -> bot CHỈ xử lý đúng mấy cái này,
# mọi hội thoại khác bị bỏ qua hoàn toàn: không đọc, không trả lời, không gắn thẻ.
# Đây là cách duy nhất chạy thử trên page THẬT mà không đụng khách thật.
# Để trống = xử lý bình thường mọi hội thoại của page.
CHI_XU_LY_IDS=

# WATCH_IDS chỉ IN THÊM LOG cho mấy id này — KHÔNG chặn xử lý. Đừng nhầm hai cái.
WATCH_IDS=

# --- PAGE THỬ (nếu có page riêng để test thì khai đè ở đây) -----------------
# PANCAKE_PAGE_ID=
# PANCAKE_PAGE_ACCESS_TOKEN=

# --- GIÁM SÁT ---------------------------------------------------------------
# Lúc chạy thử đừng cho tự thoát, để còn đọc được log trên màn hình.
GIAMSAT_TU_THOAT=off
CANH_BAO_WEBHOOK=

# --- KÝ TÊN MÁY GỬI (chỉ máy chạy thử) --------------------------------------
# Một page có hai bot, cả hai đều hiện "Public API" trong Pancake -> không biết
# tin nào của máy nào. Khai KY_TEN thì MỌI câu bot gửi kết thúc bằng "— <tên>".
# KHÁCH ĐỌC ĐƯỢC dòng này. Chỉ khai ở đây (.env.staging); bản thật đọc .env nên
# tự động không ký — vào vận hành thật không phải nhớ gỡ gì.
KY_TEN=
# KY_DAU=—                                 # dấu đứng trước tên (mặc định: —)
