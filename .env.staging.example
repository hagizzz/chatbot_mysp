# ============================================================================
# .env.staging.example — CHÉP THÀNH .env.staging RỒI ĐIỀN.
#   Chạy bằng:  chay_thu.bat        (hoặc  $env:BOT_ENV="staging"; npm start)
#
# File này chỉ khai phần KHÁC với .env. Cái gì không khai thì lấy từ .env.
# env_boot.js nạp .env.staging TRƯỚC .env, mà dotenv không ghi đè
# => giá trị ở đây thắng.
# ============================================================================

# --- CHẶN MỌI TÁC ĐỘNG THẬT -------------------------------------------------
# ORDER_DRY_RUN staging tự bật =1 (xem env_boot.js), khai lại cho rõ ràng.
ORDER_DRY_RUN=1
HOA_API_MODE=gia_lap
SHOP_ID=mysp_thu

# --- CHẠY TUẦN TỰ NHƯ BẢN CŨ ------------------------------------------------
# Lần chạy thử ĐẦU TIÊN để =1 cho giống hệt hành vi trước GĐ1.
# Chạy êm 1 ca rồi mới nâng dần 1 -> 3 -> 6.
SONG_SONG=1
MAX_MOI_NHIP=30

# --- CHỈ SOI VÀI HỘI THOẠI --------------------------------------------------
# Điền conversationId để bot CHỈ đụng vào đúng mấy hội thoại này.
# Để trống = xử lý bình thường mọi hội thoại của page.
WATCH_IDS=

# --- PAGE THỬ (nếu có page riêng để test thì khai đè ở đây) -----------------
# PANCAKE_PAGE_ID=
# PANCAKE_PAGE_ACCESS_TOKEN=

# --- GIÁM SÁT ---------------------------------------------------------------
# Lúc chạy thử đừng cho tự thoát, để còn đọc được log trên màn hình.
GIAMSAT_TU_THOAT=off
CANH_BAO_WEBHOOK=
