# ============================================================================
# .env.example — CHÉP THÀNH .env RỒI ĐIỀN. KHÔNG BAO GIỜ commit file .env thật.
#   cp .env.example .env
# Môi trường thử: tạo thêm .env.staging chỉ khai phần KHÁC, chạy bằng
#   BOT_ENV=staging node bot_worker_api_v3.js
# (xem env_boot.js — file nạp trước thắng, staging tự bật ORDER_DRY_RUN=1)
# ============================================================================

# ---------------------------------------------------------------------------
# 1. BẮT BUỘC — thiếu là bot không chạy
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...                     # khoá OpenAI (đang dùng gpt-4.1-mini)
PANCAKE_PAGE_ID=                          # ID Page Facebook thứ nhất
PANCAKE_PAGE_ACCESS_TOKEN=                # token của ĐÚNG page trên (mỗi page 1 token riêng)

# Page thứ 2..9 (cùng shop, chung sản phẩm/kịch bản) — bỏ trống nếu chỉ 1 page
PANCAKE_PAGE_ID_2=
PANCAKE_PAGE_ACCESS_TOKEN_2=
PANCAKE_PAGE_ID_3=
PANCAKE_PAGE_ACCESS_TOKEN_3=

PANCAKE_PAGE_NAME=Mys.P                   # chỉ để hiện trong log
PANCAKE_USER_ACCESS_TOKEN=                # token tài khoản Pancake (đọc danh sách hội thoại/thẻ)
BOT_NAME=BOT                              # nhãn đứng đầu mỗi dòng log

# ---------------------------------------------------------------------------
# 2. POS Pancake — dùng cho tiến trình lên đơn (order_worker.js)
# ---------------------------------------------------------------------------
PANCAKE_POS_API_KEY=
PANCAKE_POS_SHOP_ID=
PANCAKE_POS_WAREHOUSE_ID=                 # kho xuất mặc định
PANCAKE_POS_ORDER_STATUS=                 # trạng thái khi vừa tạo đơn (để trống = mặc định POS)
PANCAKE_POS_STATUS_CONFIRMED=             # trạng thái sau khi xác nhận
PANCAKE_BOT_SELLER_ID=33aded55-4e50-4f40-9fd2-474b8b9af715   # nhân viên "ảo" đứng tên đơn của bot

# ---------------------------------------------------------------------------
# 3. THẺ HỘI THOẠI — ID thẻ trong Pancake. GIÁ TRỊ MẶC ĐỊNH LÀ CỦA SHOP MYS.P,
#    shop khác BẮT BUỘC khai lại (chạy `node list_tags.js` để lấy ID thật).
# ---------------------------------------------------------------------------
PANCAKE_TAG_AI_CHOT=182                   # "AI chốt" — tín hiệu cho order_worker lên đơn
PANCAKE_TAG_AI_CHO_XL=183                 # "AI- chờ xử lý" — nhường người thật
PANCAKE_TAG_AI_DA_XACNHAN=                # gắn sau khi lên đơn xong (trống = không gắn)
PANCAKE_TAG_THIEU_DIACHI=205              # thiếu địa chỉ
PANCAKE_TAG_GUI_GAP=206                   # khách giục gửi gấp
PANCAKE_TAG_GUI_DON_GAP=                  # đơn cần gửi gấp
PANCAKE_TAG_QUA_SHOP=174                  # khách qua showroom lấy
PANCAKE_ORDER_TAG_GAP_ID=                 # thẻ "GẤP" gắn lên ĐƠN (không phải hội thoại)
PANCAKE_ORDER_TAG_GAP_NAME=GẤP

# ---------------------------------------------------------------------------
# 4. NGUỒN TIN — webhook (nhanh) + quảng cáo Facebook
# ---------------------------------------------------------------------------
WEBHOOK_PULL_URL=                         # để trống = chỉ dùng poll 4 giây
WEBHOOK_PULL_TOKEN=
FB_ADS_TOKEN=                             # trống thì đọc từ fb_ads_tokens.json
FB_ADS_ACCOUNT_IDS=                       # danh sách act_..., ngăn bằng dấu phẩy
ADS_FROM_ACTIVITIES=                      # 1 = suy nguồn quảng cáo từ activity log

# ---------------------------------------------------------------------------
# 5. GOOGLE SHEET phụ trợ (kịch bản chính nằm trong knowledge_loader.js)
#    Cần file google-service-account.json đặt cạnh mã nguồn.
# ---------------------------------------------------------------------------
QUASHOP_SHEET_ID=1Qdhp9YS0mePn7G3focqAhqV3Mb1eymFqbX0EC1bFCVs
QUASHOP_SHEET_TAB=QUA SHOP
URGENT_SHEET_ID=1Qdhp9YS0mePn7G3focqAhqV3Mb1eymFqbX0EC1bFCVs
URGENT_SHEET_TAB=Đơn gấp
PANCAKE_QUASHOP_FROM_DATE=2026-06-01
PANCAKE_QUASHOP_WAREHOUSES=

# ---------------------------------------------------------------------------
# 6. ĐƯỜNG DẪN GỬI KHÁCH
# ---------------------------------------------------------------------------
QR_URL=                                   # ảnh QR chuyển khoản
SIZE_GUIDE_URL=                           # ảnh bảng size

# ---------------------------------------------------------------------------
# 7. CÔNG TẮC HÀNH VI
# ---------------------------------------------------------------------------
AI_READ_FIRST=on                          # on = cho AI đọc hiểu trước khi regex quyết
AI_REPLY_MODE=off                         # off = AI chỉ nhả nhãn, KHÔNG tự soạn câu trả lời
ORDER_DRY_RUN=                            # 1 = chỉ in ra, KHÔNG tạo đơn thật
ORDER_POLL_MS=15000                       # nhịp quét của order_worker
ORDER_WAIT_PERSUADE_DAYS=2                # số ngày chờ trước khi thuyết phục lại

# ---------------------------------------------------------------------------
# 7a. CHẠY SONG SONG + GIỮ NHỊP GỌI PANCAKE (GĐ1, mục 3.9)
# ---------------------------------------------------------------------------
SONG_SONG=6                               # số hội thoại xử cùng lúc. =1 -> quay về cách cũ (tuần tự)
MAX_MOI_NHIP=30                           # trần số hội thoại xử trong MỘT nhịp poll
PANCAKE_RPS=4                             # request/giây cho MỖI page (Pancake bóp ~5/s)
PANCAKE_BURST=4                           # cho phép dồn tối đa bấy nhiêu request
PANCAKE_NGHI_429_MS=3000                  # dính 429 -> page đó nghỉ, giãn gấp đôi mỗi lần liên tiếp
TURNLOG=on                                # off = tắt log có cấu trúc
MEMORY_BACKEND=sqlite                     # json = quay về bộ nhớ file như trước GĐ0

# ---------------------------------------------------------------------------
# 7a2. GIÁM SÁT (GĐ1) — bắt kiểu hỏng mà tiến trình vẫn sống nhưng khách không được trả lời
# ---------------------------------------------------------------------------
GIAMSAT_DUNG_HINH_MS=180000               # vòng quét ngừng chạy quá 3 phút -> đứng hình
GIAMSAT_IM_MS=900000                      # có việc mà 15 phút không trả lời ai -> im lặng
GIAMSAT_TI_LE_LOI=0.3                     # >30% lượt lỗi -> báo động
GIAMSAT_TOI_THIEU=10                      # dưới 10 lượt thì chưa kết luận (tránh kêu oan lúc khởi động)
GIAMSAT_TU_THOAT=on                       # đứng hình -> tự thoát để start_bot.bat mở lại
CANH_BAO_WEBHOOK=                         # URL nhận cảnh báo (Slack/Telegram/...); trống = chỉ in ra log

# ---------------------------------------------------------------------------
# 8b. ĐO ĐỘ NHẬN DIỆN ẢNH (GĐ1) — chạy do_do_nhan_dien_anh.js rồi điền số đo được
# ---------------------------------------------------------------------------
# CLIP_MIN_SCORE / CLIP_MIN_GAP ở mục 8 bên dưới. Mặc định hiện tại 0.80 / 0.04
# CHƯA TỪNG ĐƯỢC ĐO — đo xong hãy đặt lại theo cặp mà bộ đo đề xuất (sai = 0).

# ---------------------------------------------------------------------------
# 7b. HỆ THỐNG QUẢN TRỊ HỘI THOẠI CỦA BẠN HOÀ (mục 8) — xem docs/HOP_DONG_API_HOA.md
# ---------------------------------------------------------------------------
HOA_API_MODE=gia_lap                      # gia_lap = ghi ra data/hoa_gia_lap.jsonl, KHÔNG gọi ra ngoài
HOA_API_URL=                              # điền khi đã chốt hợp đồng API
HOA_API_TOKEN=
HOA_CK_CHO_TOI_DA_MS=900000               # chờ tối đa 15 phút chưa thấy tiền -> giao người thật
SHOP_ID=mysp                              # dùng cho log/thống kê và tách dữ liệu ở GĐ2

# ---------------------------------------------------------------------------
# 8. NHẬN DIỆN ẢNH (worker Python)
# ---------------------------------------------------------------------------
CLIP_MIN_SCORE=                           # ngưỡng điểm CLIP tối thiểu để dám khẳng định
CLIP_MIN_GAP=                             # khoảng cách tối thiểu giữa hạng 1 và hạng 2

# ---------------------------------------------------------------------------
# 9. GỠ LỖI — để trống khi chạy thật, bật lên khi soi 1 ca cụ thể
# ---------------------------------------------------------------------------
WATCH_IDS=                                # chỉ xử lý/soi các conversationId này
WATCH_NAMES=                              # lọc theo tên khách
DUMP_CONV=                                # in nguyên hội thoại (1 = tất cả, hoặc 1 id)
DUMP_RAW=
DUMP_REPLY=
DUMP_COMMENT=
DUMP_EMPTY=
LIST_DEBUG=
LIST_DUMP_NAME=
READER_DEBUG=
SHOW_QUEUE=
CHECK_NAMES=
