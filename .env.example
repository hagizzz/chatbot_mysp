# ============================================================================
# .env.example — CHÉP THÀNH .env RỒI ĐIỀN. KHÔNG BAO GIỜ commit file .env thật.
#   cp .env.example .env
# Môi trường thử: tạo thêm .env.staging chỉ khai phần KHÁC, chạy bằng
#   BOT_ENV=staging node bot_worker_api_v3.js
# (xem env_boot.js — file nạp trước thắng, staging tự bật ORDER_DRY_RUN=1)
# ============================================================================

# ---------------------------------------------------------------------------
# 1. BẮT BUỘC — thiếu là bot không chạy
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...                     # khoá OpenAI (đang dùng gpt-4.1-mini)
PANCAKE_PAGE_ID=                          # ID Page Facebook thứ nhất
PANCAKE_PAGE_ACCESS_TOKEN=                # token của ĐÚNG page trên (mỗi page 1 token riêng)

# Page thứ 2..9 (cùng shop, chung sản phẩm/kịch bản) — bỏ trống nếu chỉ 1 page
PANCAKE_PAGE_ID_2=
PANCAKE_PAGE_ACCESS_TOKEN_2=
PANCAKE_PAGE_ID_3=
PANCAKE_PAGE_ACCESS_TOKEN_3=

PANCAKE_PAGE_NAME=Mys.P                   # chỉ để hiện trong log
PANCAKE_USER_ACCESS_TOKEN=                # token tài khoản Pancake (đọc danh sách hội thoại/thẻ)
BOT_NAME=BOT                              # nhãn đứng đầu mỗi dòng log

# ---------------------------------------------------------------------------
# 2. POS Pancake — dùng cho tiến trình lên đơn (order_worker.js)
# ---------------------------------------------------------------------------
PANCAKE_POS_API_KEY=
PANCAKE_POS_SHOP_ID=
PANCAKE_POS_WAREHOUSE_ID=                 # kho xuất mặc định
PANCAKE_POS_ORDER_STATUS=                 # trạng thái khi vừa tạo đơn (để trống = mặc định POS)
PANCAKE_POS_STATUS_CONFIRMED=             # trạng thái sau khi xác nhận
PANCAKE_BOT_SELLER_ID=33aded55-4e50-4f40-9fd2-474b8b9af715   # nhân viên "ảo" đứng tên đơn của bot

# ---------------------------------------------------------------------------
# 3. THẺ HỘI THOẠI — ID thẻ trong Pancake. GIÁ TRỊ MẶC ĐỊNH LÀ CỦA SHOP MYS.P,
#    shop khác BẮT BUỘC khai lại (chạy `node list_tags.js` để lấy ID thật).
# ---------------------------------------------------------------------------
PANCAKE_TAG_AI_CHOT=182                   # "AI chốt" — tín hiệu cho order_worker lên đơn
PANCAKE_TAG_AI_CHO_XL=183                 # "AI- chờ xử lý" — nhường người thật
PANCAKE_TAG_AI_DA_XACNHAN=                # gắn sau khi lên đơn xong (trống = không gắn)
PANCAKE_TAG_THIEU_DIACHI=205              # thiếu địa chỉ
PANCAKE_TAG_GUI_GAP=206                   # khách giục gửi gấp
PANCAKE_TAG_GUI_DON_GAP=                  # đơn cần gửi gấp
PANCAKE_TAG_QUA_SHOP=174                  # khách qua showroom lấy
PANCAKE_ORDER_TAG_GAP_ID=                 # thẻ "GẤP" gắn lên ĐƠN (không phải hội thoại)
PANCAKE_ORDER_TAG_GAP_NAME=GẤP

# ---------------------------------------------------------------------------
# 4. NGUỒN TIN — webhook (nhanh) + quảng cáo Facebook
# ---------------------------------------------------------------------------
WEBHOOK_PULL_URL=                         # để trống = chỉ dùng poll 4 giây
WEBHOOK_PULL_TOKEN=
FB_ADS_TOKEN=                             # trống thì đọc từ fb_ads_tokens.json
FB_ADS_ACCOUNT_IDS=                       # danh sách act_..., ngăn bằng dấu phẩy
ADS_FROM_ACTIVITIES=                      # 1 = suy nguồn quảng cáo từ activity log

# ---------------------------------------------------------------------------
# 5. NGUỒN DỮ LIỆU GOOGLE — SHOP MỚI BẮT BUỘC KHAI LẠI CẢ BA
#    Cần file google-service-account.json đặt cạnh mã nguồn (chia quyền đọc
#    Sheet/Doc cho email trong tệp đó).
#    Để trống = dùng nguồn của MYS.P. Bot vẫn chạy trơn tru nhưng đọc danh mục
#    và kịch bản của shop KHÁC — không có dấu hiệu nào báo sai, chỉ có dòng
#    cảnh báo lúc khởi động. Đừng để trống khi mở shop mới.
# ---------------------------------------------------------------------------
CATALOG_SHEET_ID=                         # Sheet danh mục sản phẩm (mã, tên, giá, màu, size)
CATALOG_SHEET_TABS=Mẫu 2026,Mẫu 2025      # các tab đọc, ngăn bằng dấu phẩy
KICH_BAN_DOC_ID=                          # Google Doc chứa kịch bản bán hàng
LUAT_SHEET_ID=                            # Sheet chứa tab luật tình huống
LUAT_SHEET_TAB=AI AGENT                   # tên tab luật trong Sheet trên

# ---------------------------------------------------------------------------
# 5b. GOOGLE SHEET phụ trợ
# ---------------------------------------------------------------------------
QUASHOP_SHEET_ID=1Qdhp9YS0mePn7G3focqAhqV3Mb1eymFqbX0EC1bFCVs
QUASHOP_SHEET_TAB=QUA SHOP
URGENT_SHEET_ID=1Qdhp9YS0mePn7G3focqAhqV3Mb1eymFqbX0EC1bFCVs
URGENT_SHEET_TAB=Đơn gấp
PANCAKE_QUASHOP_FROM_DATE=2026-06-01
PANCAKE_QUASHOP_WAREHOUSES=

# ---------------------------------------------------------------------------
# 6. ĐƯỜNG DẪN GỬI KHÁCH
# ---------------------------------------------------------------------------
QR_URL=                                   # ảnh QR chuyển khoản
SIZE_GUIDE_URL=                           # ảnh bảng size

# ---------------------------------------------------------------------------
# 7. CÔNG TẮC HÀNH VI
# ---------------------------------------------------------------------------
AI_READ_FIRST=on                          # on = cho AI đọc hiểu trước khi regex quyết
AI_REPLY_MODE=off                         # off = AI chỉ nhả nhãn, KHÔNG tự soạn câu trả lời
NGUONG_TIN_CAY=0.6                        # AI tự chấm do_tin_cay < ngưỡng này -> giao NGƯỜI THẬT (im, gắn AI-CHỜ XL)

# --- THẺ GIỮ: khi nào bot được nhận lại hội thoại -------------------------
# Mọi thẻ giữ (183 CHỜ XL, 184 AI-XL ảnh, 185 ĐƠN ƯU TIÊN, 166, 177) đều làm bot
# DỪNG HẲN — "cần người thật vào xử lý thì bot không làm gì tiếp".
#
# off (mặc định) = GỠ THẺ là bot chạy lại ngay, bất kể nhân viên đã nhắn khách chưa.
# on             = phải đủ CẢ HAI: thẻ đã gỡ VÀ có tin của người thật gửi SAU lúc
#                  hội thoại bị giữ. Chặt hơn, tránh cảnh gỡ thẻ để dọn hàng đợi
#                  mà chưa ai trả lời khách -> bot nhảy vào giữa chừng.
# Shop chốt 25/08/2026: tạm để off, siết sang on sau khi quen quy trình.
SIET_NHAN_VIEN_TRA_LOI=off

# --- TÁCH TIN DỒN DẬP ------------------------------------------------------
# Câu gộp cả báo giá + size + xin liên hệ vào một tin đọc rất dồn. Bật thì tách
# thành nhiều tin: 1 tin báo giá, 1 tin size, 1 tin xác nhận địa chỉ + sđt.
TACH_TIN=on

# --- BÁM KHÁCH (nhắc lại khách bỏ giữa chừng) — mục 4.5 yêu cầu tính năng ---
# Khách hỏi giá rồi im, bot nhắn lại để kéo khách quay lại.
# Shop khai ở đây, bot chỉ chạy theo — không tự quyết nhắc bao nhiêu lần.
# Sửa xong phải KHỞI ĐỘNG LẠI bot.
BAM_KHACH=on                              # off = tắt hẳn, bot không nhắc lần nào
BAM_KHACH_LAN1_PHUT=10                    # đợt mở đầu: bao nhiêu PHÚT khách im thì nhắc lần 1
BAM_KHACH_LAN2_GIO=2                      # nhắc lần 2 sau bao nhiêu GIỜ (cũng là mốc cho các đợt sau)
BAM_KHACH_SO_LAN=2                        # tối đa mấy lần nhắc trong một hội thoại (0 = không nhắc, trần 5)
# CHƯA khai được ở đây (còn viết cứng trong mã, để GĐ5):
#   · nội dung từng câu nhắc  -> pickFollowupAction() trong bot_worker_api_v3.js
#   · trường hợp nào ngừng nhắc -> 10 điều kiện trong scheduleFollowup()
# Bot LUÔN tự ngừng nhắc khi: đã chốt đơn · đã nhường người thật · hội thoại còn thẻ giữ
#   · mẫu hết hàng · không có size vừa · mẫu đã nằm trong đơn.

# Ranh gioi "code lo so / kich ban lo loi" tren duong AI-QUYET.
#   shadow (mac dinh) = chi ghi log cau vi pham, KHONG doi hanh vi
#   on                = cau AI dinh tien/sdt/chot-don -> thay bang phom code
#   off               = tat han
RANH_GIOI_MODE=shadow

# CONG CHAN CUOI — khach khong duoc roi lang le.
# Do 25/08/2026 tren 46 kich ban thu: 4 ca bot KHONG noi cau nao, KHONG gan the,
# khong ca mot dong log noi vi sao. Khach ngoi cho, nhan vien khong biet co khach cho.
# Ca bon deu cung kieu: bot khong tra ra mau (khach noi "vay nay" khong kem anh,
# hoac go sai ten mau) -> roi ra khoi moi nhanh.
# Day la LUOI AN TOAN, khong phai ban va nguyen nhan.
#   shadow (mac dinh) chi ghi so + in "[ROI LANG shadow] ..." — KHONG gan the, KHONG doi hanh vi.
#                     Chay vai ngay, dem `grep -c "ROI LANG" botlog/*.log` roi moi quyet.
#   on                gan the AI-CHO XL + danh dau chua doc de nhan vien vao xu.
#   off               tat han.
# Khai o kich_ban/<shop>.json muc "cai_dat" thi thang dong nay (moi shop mot khac).
RAI_LANG_MODE=shadow

# MO MAN SAN PHAM — nhip tra loi cho tin DAU TIEN cua khach ve mot mau:
#   1) bao gia  ->  2) ba anh mau  ->  3) tra loi dung cau khach hoi  ->  4) cau duoi
# Vi du: khach gui anh mau + hoi "co mau khac khong" thi van bao gia + gui anh
# truoc, roi moi tra loi chuyen mau, cuoi cung moi hoi size.
#   on      (mac dinh) chay that
#   shadow  chi ghi log "[MO-MAN shadow] …", KHONG doi hanh vi — soi vai ngay roi bat
#   off     tat han, ve dung nhip cu
MO_MAN_MODE=on

# Ten bot — mot nguon duy nhat, dung chung cho log va prompt (danh_tinh_bot.js)
TEN_BOT=Bảo Trâm
# Cach xung ho — moi shop mot khac (nganh hang nam/nu, tuoi khach). danh_tinh_bot.js
BOT_XUNG=em
BOT_GOI_KHACH=chị
# Ten bot HIEN TRONG PANCAKE (admin_name), KHAC ten noi voi khach o tren.
# Pancake dong dau ten nguoi gui len moi tin phia shop; bot dua vao dau nay de
# biet "nhan vien that da vao xu chua" ma dung ngoai. Doi ten hien thi ben
# Pancake ma quen khai lai o day -> bot tuong tin CUA CHINH NO la tin nhan vien
# -> tu nhuong -> im luon. Ngan cach bang dau phay.
NHAN_BOT_PANCAKE=Public API,Botcake
ORDER_DRY_RUN=                            # 1/true/yes/on = chỉ in payload, KHÔNG tạo đơn thật
                                          # (BOT_ENV=staging tự bật cái này)
ORDER_POLL_MS=15000                       # nhịp quét của order_worker
DON_NGUON=ca_hai                          # tín hiệu "hội thoại đã chốt" lấy từ đâu:
                                          #   bang   = chỉ hàng đợi SQLite (bot ghi vào) — sạch nhất
                                          #   the    = chỉ thẻ 182 trên Pancake — cách cũ, để quay lui
                                          #   ca_hai = cả hai, bỏ trùng (mặc định; giữ thói quen NV gắn tay thẻ)
DON_CANH_BAO_SAU_LAN=40                   # thử bấy nhiêu lần chưa lên được đơn -> kêu (40 x 15s = 10 phút)
ORDER_WAIT_PERSUADE_DAYS=2                # số ngày chờ trước khi thuyết phục lại

# ---------------------------------------------------------------------------
# 7a. CHẠY SONG SONG + GIỮ NHỊP GỌI PANCAKE (GĐ1, mục 3.9)
# ---------------------------------------------------------------------------
CHI_XU_LY_IDS=                            # [CHẠY THỬ] chỉ xử lý đúng các conversationId này (ngăn bằng phẩy).
                                          # Trống = bình thường. KHÁC WATCH_IDS (cái kia chỉ in log).
SONG_SONG=6                               # số hội thoại xử cùng lúc. =1 -> quay về cách cũ (tuần tự)
MAX_MOI_NHIP=30                           # trần số hội thoại xử trong MỘT nhịp poll
PANCAKE_RPS=4                             # request/giây cho MỖI page (Pancake bóp ~5/s)
PANCAKE_BURST=4                           # cho phép dồn tối đa bấy nhiêu request
PANCAKE_NGHI_429_MS=3000                  # dính 429 -> page đó nghỉ, giãn gấp đôi mỗi lần liên tiếp
TURNLOG=on                                # off = tắt log có cấu trúc
MEMORY_BACKEND=sqlite                     # json = quay về bộ nhớ file như trước GĐ0

# ---------------------------------------------------------------------------
# 7a2. GIÁM SÁT (GĐ1) — bắt kiểu hỏng mà tiến trình vẫn sống nhưng khách không được trả lời
# ---------------------------------------------------------------------------
GIAMSAT_DUNG_HINH_MS=180000               # vòng quét ngừng chạy quá 3 phút -> đứng hình
GIAMSAT_IM_MS=900000                      # có việc mà 15 phút không trả lời ai -> im lặng
GIAMSAT_TI_LE_LOI=0.3                     # >30% lượt lỗi -> báo động
GIAMSAT_TOI_THIEU=10                      # dưới 10 lượt thì chưa kết luận (tránh kêu oan lúc khởi động)
GIAMSAT_TU_THOAT=on                       # đứng hình -> tự thoát để start_bot.bat mở lại
CANH_BAO_WEBHOOK=                         # URL nhận cảnh báo (Slack/Telegram/...); trống = chỉ in ra log

# ---------------------------------------------------------------------------
# 8b. ĐO ĐỘ NHẬN DIỆN ẢNH (GĐ1) — chạy do_do_nhan_dien_anh.js rồi điền số đo được
# ---------------------------------------------------------------------------
# CLIP_MIN_SCORE / CLIP_MIN_GAP ở mục 8 bên dưới. Mặc định hiện tại 0.80 / 0.04
# CHƯA TỪNG ĐƯỢC ĐO — đo xong hãy đặt lại theo cặp mà bộ đo đề xuất (sai = 0).

# ---------------------------------------------------------------------------
# 7b. HỆ THỐNG QUẢN TRỊ HỘI THOẠI CỦA BẠN HOÀ (mục 8) — xem docs/HOP_DONG_API_HOA.md
# ---------------------------------------------------------------------------
HOA_API_MODE=gia_lap                      # gia_lap = ghi ra data/hoa_gia_lap.jsonl, KHÔNG gọi ra ngoài
HOA_API_URL=                              # điền khi đã chốt hợp đồng API
HOA_API_TOKEN=
HOA_CK_CHO_TOI_DA_MS=900000               # chờ tối đa 15 phút chưa thấy tiền -> giao người thật
SHOP_ID=mysp                              # dùng cho log/thống kê và tách dữ liệu ở GĐ2

# ---------------------------------------------------------------------------
# 8. NHẬN DIỆN ẢNH (worker Python)
# ---------------------------------------------------------------------------
PYTHON_BIN=                               # trống = dùng lệnh "python". Máy nào dùng "py" hoặc python
                                          # trong venv thì khai đường dẫn đầy đủ ở đây.
CLIP_MIN_SCORE=                           # ngưỡng điểm CLIP tối thiểu để dám khẳng định
CLIP_MIN_GAP=                             # khoảng cách tối thiểu giữa hạng 1 và hạng 2

# ---------------------------------------------------------------------------
# 9. GỠ LỖI — để trống khi chạy thật, bật lên khi soi 1 ca cụ thể
# ---------------------------------------------------------------------------
WATCH_IDS=                                # chỉ xử lý/soi các conversationId này
WATCH_NAMES=                              # lọc theo tên khách
DUMP_CONV=                                # in nguyên hội thoại (1 = tất cả, hoặc 1 id)
DUMP_RAW=
DUMP_REPLY=
DUMP_COMMENT=
DUMP_EMPTY=
LIST_DEBUG=
LIST_DUMP_NAME=
READER_DEBUG=
SHOW_QUEUE=
CHECK_NAMES=

# ============================================================================
# NGUỒN HỘI THOẠI — Pancake hay mfs
# ----------------------------------------------------------------------------
# Bỏ trống / pancake = giữ nguyên hành vi cũ. Đặt mfs = đọc, gửi tin và gắn thẻ
# đi qua hệ thống mfs thay cho Pancake. ĐƠN HÀNG KHÔNG ĐỔI: vẫn là Pancake POS.
# Xem docs/NOI_BOT_SANG_MFS.md
# ============================================================================
NGUON_TIN=pancake

MFS_API_URL=http://localhost:3000/v1
MFS_EMAIL=
MFS_PASSWORD=

# Tên thẻ trong mfs theo VAI TRÒ bot dùng. Thẻ chưa có thì bot tự tạo.
MFS_THE_CHO_NGUOI_THAT=Chờ người thật
MFS_THE_AI_CHOT=Đã chốt đơn
MFS_THE_XU_LY_ANH=Ảnh chưa nhận ra
MFS_THE_DON_UU_TIEN=Đơn ưu tiên
MFS_THE_GUI_DON_GAP=Gửi gấp

# Cửa sổ quét: chỉ lấy hội thoại có tin mới trong ngần này giờ
MFS_SO_GIO=24
MFS_GIOI_HAN_DS=100

# ============================================================================
# MỐC BỎ QUA TIN CŨ — "lịch sử hội thoại bắt đầu từ đây"
# ----------------------------------------------------------------------------
# Messenger KHÔNG cho xoá tin nhắn: API Meta không có endpoint xoá tin trong
# hội thoại, Pancake public_api cũng không. Nên muốn bot "quên" lịch sử thì
# phải CHE: tin cũ hơn mốc coi như không tồn tại — không vào cửa sổ 20 tin của
# AI, không thành tin cần trả lời.
#
# ĐẶT DÒNG NÀY TRƯỚC NGÀY ĐẦU BẬT BOT TRÊN PAGE THẬT.
# Page của shop đang có hàng trăm hội thoại với cả năm lịch sử. Không có mốc
# thì hôm bật bot, nó đọc hết đống cũ đó và trả lời lại.
#
# Bỏ trống = không có mốc = đọc toàn bộ lịch sử (hành vi cũ).
# Mốc RIÊNG cho từng hội thoại nằm ở moc_bo_qua.json (reset_hoi_thoai.js ghi).
# Bot lấy mốc MUỘN HƠN giữa hai cái, nên dòng này là hàng rào không lách được.
#
#   node moc_bo_qua.js                     xem mốc đang có
#   node reset_hoi_thoai.js <convId> --lam dọn 1 hội thoại + đặt mốc = bây giờ
# ============================================================================
BO_QUA_TIN_TRUOC=
